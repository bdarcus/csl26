{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.citum.org/style-coverage-audit-manifest-v1.json",
  "title": "Citum style coverage audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet-id",
    "surfaces",
    "expected-observations",
    "source",
    "style",
    "fixtures",
    "authority",
    "relevance",
    "intentional-omissions"
  ],
  "properties": {
    "schema": {
      "const": "citum.style-coverage-audit-manifest/v1"
    },
    "packet-id": {
      "type": "string",
      "minLength": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["bibliography", "citation"] }
    },
    "expected-observations": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "worktree-clean"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "worktree-clean": { "type": "boolean" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "chain"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/namedFile" }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references"],
      "properties": {
        "references": { "$ref": "#/definitions/namedFile" },
        "citations": {
          "anyOf": [
            { "$ref": "#/definitions/namedFile" },
            { "type": "null" }
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "evidence-run-id", "inputs", "report"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "evidence-run-id": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/namedFile" }
        },
        "report": { "$ref": "#/definitions/file" }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "excluded"],
      "properties": {
        "default": { "const": "relevant" },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "intentional-omissions": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "namedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "rationale"],
      "properties": {
        "surface": { "enum": ["bibliography", "citation", "*"] },
        "reference-type": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "reference-id": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
